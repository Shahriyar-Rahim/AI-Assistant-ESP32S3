APP_ENV=development
DATABASE_URL=sqlite:///./assistant.db
DEVICE_TOKEN=replace-with-a-long-random-device-token
SIMULATOR_TOKEN=replace-with-a-different-long-random-simulator-token
AUTH_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ACCESS_TOKEN_MINUTES=60

ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120

AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
STT_PROVIDER=openai
STT_LANGUAGE=en
TTS_PROVIDER=openai  # openai | gemini | piper (free, local; needs piper-tts and PIPER_VOICE_MODEL) | local
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

WAKE_WORD=hey buddy
WAKE_WORD_MODEL_PATH=
WAKE_WORD_THRESHOLD=0.5
VAD_RMS_THRESHOLD=450
VAD_END_SILENCE_MS=900
MAX_AUDIO_FRAME_BYTES=4096
ANTI_SPOOF_MODEL_PATH=
ANTI_SPOOF_THRESHOLD=0.8
BIOMETRIC_THRESHOLD=0.75
# Keep enforce for production; enrolled_only skips biometrics until the first voice enrollment exists.
BIOMETRIC_MODE=enforce
VOICE_ENCRYPTION_KEY=
PERSONALIZATION_AUDIO_RETENTION_DAYS=30

INTEGRATION_ENCRYPTION_KEY=
GITHUB_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

AUDIT_RETENTION_DAYS=365
FIRMWARE_STORAGE_DIR=./firmware-releases
MAX_AUDIO_UPLOAD_BYTES=20000000
LOCAL_BRAIN_FIRST=true
AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Camera security. Telegram: create a bot with @BotFather for the token; message the bot once, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates to read your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CAMERA_ENABLED=false
# local = USB camera on the backend PC, device = JPEG frames pushed by the ESP32-S3, auto = device when frames arrive, else local
CAMERA_SOURCE=local
CAMERA_INDEX=0
# Load the 38 MB face-recognition model only while a face is in view (saves RAM)
CAMERA_LOW_MEMORY=true
CAMERA_INTERVAL_SECONDS=0.7
CAMERA_OWNER_GRACE_SECONDS=45
CAMERA_AWAY_RECORD_AFTER_SECONDS=60
CAMERA_SEGMENT_SECONDS=300
VISION_DIR=data/vision
